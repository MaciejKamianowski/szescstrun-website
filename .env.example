# Baza danych PostgreSQL
DATABASE_URL=postgresql://szescstrun:szescstrun@127.0.0.1:5432/szescstrun

# Sekret Payload (wygeneruj silny ciąg, np. openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Publiczny URL aplikacji
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Formularz kontaktowy — Resend
# https://resend.com
RESEND_API_KEY=
CONTACT_EMAIL_TO=
EMAIL_FROM="Sześć Strun <kontakt@twoja-domena.pl>"

# Opcjonalnie: Cloudflare Turnstile (antyspam)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Produkcja: storage S3-compatible (np. Cloudflare R2)
# Gdy S3_BUCKET i S3_ENDPOINT są ustawione, media trafiają do bucketa.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
