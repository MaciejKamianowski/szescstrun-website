# Baza danych PostgreSQL
DATABASE_URL=postgresql://szescstrun:szescstrun@127.0.0.1:5432/szescstrun

# Sekret Payload (wygeneruj silny ciąg, np. openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Publiczny URL aplikacji (lokalnie localhost; na Railway: https://www.szescstrun.pl)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Opcjonalny runtime override (nie jest inlinowany przez Next przy buildzie):
# SERVER_URL=https://www.szescstrun.pl

# Formularz kontaktowy — Resend
# https://resend.com — domena wysyłkowa: mail.szescstrun.pl (musi być Verified w Resend)
# Nie wysyłaj prawdziwych wiadomości testowych przed weryfikacją domeny.
RESEND_API_KEY=
CONTACT_EMAIL_TO=                 # adres e-mail Jacka (odbiorca zgłoszeń)
EMAIL_FROM="Sześć Strun <formularz@mail.szescstrun.pl>"

# Opcjonalnie: Cloudflare Turnstile (antyspam)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3 API) — media Payload CMS
# Bucket: szescstrun-media
#
# R2_ENDPOINT = prywatny endpoint S3 API (NIE używaj w <img src>)
# R2_PUBLIC_URL = publiczny odczyt (r2.dev lub custom CDN) — bez trailing slash
# Bez R2_PUBLIC_URL aplikacja używa bezpiecznego proxy: /api/media/file/...
# ---------------------------------------------------------------------------
R2_BUCKET=szescstrun-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_PUBLIC_URL=

# Aliasy kompatybilności (opcjonalne — używane gdy brak R2_*)
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=
